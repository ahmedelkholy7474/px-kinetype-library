{
  "id": "squeezy-counter",
  "name": "Squeezy Counter",
  "version": 4,
  "order": 6,
  "status": "ready",
  "requires": "2.0",
  "description": "Select your number text layer (e.g. 25,000) and press Count: it counts up from 0 on the same layer, without shaking. Everything else is under Advanced.",
  "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M4 20v-4M9 20v-8M14 20v-12\"/><path d=\"M18 9l2-2 2 2M20 7v9\"/></svg>",
  "colors": [
    "#5B6CFF",
    "#F0508A"
  ],
  "include": [],
  "scriptFile": "counter.jsx",
  "runLabel": "Count",
  "params": [
    {
      "id": "action",
      "label": "Do",
      "type": "select",
      "options": [
        "Count",
        "Update selected counter",
        "Pick font…",
        "Apply text style to counter"
      ],
      "value": "Count"
    },
    {
      "id": "duration",
      "label": "Duration",
      "type": "slider",
      "min": 0.1,
      "max": 10,
      "step": 0.1,
      "value": 2,
      "unit": "s"
    },
    {
      "id": "symbol",
      "label": "Symbol",
      "type": "select",
      "options": [
        "None",
        "%",
        "$",
        "€",
        "£",
        "+",
        "K",
        "M",
        "B",
        "×",
        "°",
        "#",
        "AED",
        "د.إ",
        "SAR",
        "ر.س",
        "EGP",
        "ج.م",
        "OMR",
        "ر.ع"
      ],
      "value": "None"
    },
    {
      "id": "easing",
      "label": "Easing",
      "type": "select",
      "options": [
        "Smooth Stop",
        "Ease In-Out",
        "Linear",
        "Expo Out"
      ],
      "value": "Smooth Stop"
    },
    {
      "id": "start",
      "label": "Start from",
      "type": "text",
      "value": "0",
      "advanced": true
    },
    {
      "id": "end",
      "label": "Count to (if the layer has no number)",
      "type": "text",
      "value": "25000",
      "advanced": true
    },
    {
      "id": "side",
      "label": "Symbol side",
      "type": "select",
      "options": [
        "Auto",
        "Left",
        "Right"
      ],
      "value": "Auto",
      "advanced": true
    },
    {
      "id": "decimals",
      "label": "Decimals",
      "type": "select",
      "options": [
        "0",
        "1",
        "2",
        "3"
      ],
      "value": "0",
      "advanced": true
    },
    {
      "id": "commas",
      "label": "Commas",
      "type": "checkbox",
      "value": true,
      "advanced": true
    },
    {
      "id": "commaFrom",
      "label": "Commas from",
      "type": "text",
      "value": "10000",
      "advanced": true
    },
    {
      "id": "digits",
      "label": "Digits",
      "type": "select",
      "options": [
        "Western 123",
        "Arabic ١٢٣"
      ],
      "value": "Western 123",
      "advanced": true
    },
    {
      "id": "align",
      "label": "Align",
      "type": "select",
      "options": [
        "Left",
        "Center",
        "Right"
      ],
      "value": "Center",
      "advanced": true
    },
    {
      "id": "font",
      "label": "Font (empty = your text layer's font)",
      "type": "text",
      "value": "",
      "placeholder": "e.g. Montserrat Bold (empty = selected text)",
      "advanced": true
    },
    {
      "id": "useSelected",
      "label": "Use my selected text layer",
      "type": "checkbox",
      "value": true,
      "advanced": true
    },
    {
      "id": "fromText",
      "label": "Read the number from the layer",
      "type": "checkbox",
      "value": true,
      "advanced": true
    },
    {
      "id": "prefix",
      "label": "Prefix",
      "type": "text",
      "value": "",
      "advanced": true
    },
    {
      "id": "suffix",
      "label": "Suffix",
      "type": "text",
      "value": "",
      "advanced": true
    },
    {
      "id": "mode",
      "label": "Mode",
      "type": "select",
      "options": [
        "One layer",
        "Per-digit layers"
      ],
      "value": "One layer",
      "advanced": true
    },
    {
      "id": "glide",
      "label": "Glide",
      "type": "slider",
      "min": 0,
      "max": 1,
      "step": 0.05,
      "value": 0.25,
      "unit": "s",
      "advanced": true
    }
  ]
}