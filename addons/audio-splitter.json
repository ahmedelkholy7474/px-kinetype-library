{
  "id": "audio-splitter",
  "name": "Audio Splitter",
  "version": 3,
  "order": 6,
  "status": "ready",
  "requires": "2.0",
  "changes": "Setup fix: ffmpeg is now provided for the vocal model",
  "description": "Split a video or audio layer into Vocals, Music and SFX stems with AI, right inside AE. First run installs a local engine (one time, about 2 GB).",
  "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.9\" stroke-linecap=\"round\"><path d=\"M3 12h3l2-5 3 10 2-6 1.5 3H16\"/><path d=\"M16 12h5M16 12l4-5h1M16 12l4 5h1\"/></svg>",
  "colors": [
    "#2EE6FF",
    "#8B6CFF"
  ],
  "include": [
    "_common.jsx"
  ],
  "assets": {
    "AS_SPLIT_PY": "audio-splitter/split.py",
    "AS_INSTALL_MAC": "audio-splitter/install-mac.command",
    "AS_INSTALL_WIN": "audio-splitter/install-windows.bat"
  },
  "scriptFile": "audio-splitter.jsx",
  "runLabel": "Split",
  "params": [
    {
      "id": "action",
      "label": "Action",
      "type": "select",
      "options": [
        "Split",
        "Split again",
        "Install / repair engine"
      ],
      "value": "Split"
    },
    {
      "id": "quality",
      "label": "Quality",
      "type": "select",
      "options": [
        "Best",
        "Fast"
      ],
      "value": "Best"
    },
    {
      "id": "vocals",
      "label": "Vocals",
      "type": "checkbox",
      "value": true
    },
    {
      "id": "music",
      "label": "Music",
      "type": "checkbox",
      "value": true
    },
    {
      "id": "sfx",
      "label": "SFX",
      "type": "checkbox",
      "value": true
    },
    {
      "id": "mute",
      "label": "Mute original",
      "type": "checkbox",
      "value": true,
      "advanced": true
    },
    {
      "id": "stereo",
      "label": "Stereo stems (2x slower)",
      "type": "checkbox",
      "value": false,
      "advanced": true
    }
  ]
}