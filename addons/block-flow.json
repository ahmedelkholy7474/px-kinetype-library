{
  "id": "block-flow",
  "name": "Block Flow",
  "version": 3,
  "order": 3,
  "status": "ready",
  "description": "Cards side by side, overlapping. Each new image takes its slot through a grid-block glitch (crisp, mosaic and accent blocks) while the whole frame steps down in scale. Select layers in your comp, or images in the Project panel.",
  "icon": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><rect x=\"3\" y=\"3\" width=\"8\" height=\"8\" rx=\"1.5\"/><rect x=\"13\" y=\"3\" width=\"8\" height=\"8\" rx=\"1.5\" opacity=\".55\"/><rect x=\"3\" y=\"13\" width=\"8\" height=\"8\" rx=\"1.5\" opacity=\".55\"/><rect x=\"13\" y=\"13\" width=\"8\" height=\"8\" rx=\"1.5\"/></svg>",
  "colors": [
    "#C04CFF",
    "#E040C8"
  ],
  "include": [],
  "scriptFile": "block-flow.jsx",
  "runLabel": "Build",
  "params": [
    {
      "id": "slots",
      "label": "Slots",
      "type": "slider",
      "min": 1,
      "max": 6,
      "value": 2
    },
    {
      "id": "overlap",
      "label": "Overlap",
      "type": "slider",
      "min": 0,
      "max": 60,
      "value": 12,
      "unit": "%"
    },
    {
      "id": "cardScale",
      "label": "Card scale",
      "type": "slider",
      "min": 10,
      "max": 200,
      "value": 100,
      "unit": "%"
    },
    {
      "id": "cardW",
      "label": "Card width (layer = own size)",
      "type": "text",
      "value": "layer"
    },
    {
      "id": "cardH",
      "label": "Card height (layer = own size)",
      "type": "text",
      "value": "layer"
    },
    {
      "id": "cols",
      "label": "Grid columns",
      "type": "slider",
      "min": 1,
      "max": 40,
      "value": 8
    },
    {
      "id": "pad",
      "label": "Spill cells",
      "type": "slider",
      "min": 0,
      "max": 6,
      "value": 2
    },
    {
      "id": "interval",
      "label": "Interval",
      "type": "slider",
      "min": 0.1,
      "max": 4,
      "step": 0.05,
      "value": 0.85,
      "unit": "s"
    },
    {
      "id": "trans",
      "label": "Transition",
      "type": "slider",
      "min": 0.1,
      "max": 2,
      "step": 0.05,
      "value": 0.5,
      "unit": "s"
    },
    {
      "id": "zoomAmt",
      "label": "Scale down",
      "type": "slider",
      "min": 0,
      "max": 60,
      "value": 27,
      "unit": "%"
    },
    {
      "id": "jitter",
      "label": "Jitter",
      "type": "slider",
      "min": 0,
      "max": 80,
      "value": 14,
      "unit": "px"
    },
    {
      "id": "seed",
      "label": "Seed",
      "type": "slider",
      "min": 1,
      "max": 999,
      "value": 7
    },
    {
      "id": "accentHex",
      "label": "Accent colour (hex)",
      "type": "text",
      "value": "#00D2B4"
    },
    {
      "id": "accentAmt",
      "label": "Accent blocks",
      "type": "slider",
      "min": 0,
      "max": 100,
      "value": 35,
      "unit": "%"
    },
    {
      "id": "mosaicAmt",
      "label": "Pixel blocks",
      "type": "slider",
      "min": 0,
      "max": 100,
      "value": 40,
      "unit": "%"
    },
    {
      "id": "mosaicDetail",
      "label": "Pixel detail",
      "type": "slider",
      "min": 1,
      "max": 6,
      "value": 2
    },
    {
      "id": "clipToShape",
      "label": "Keep blocks inside the layer",
      "type": "checkbox",
      "value": true
    },
    {
      "id": "rightOnTop",
      "label": "Right card on top",
      "type": "checkbox",
      "value": true
    },
    {
      "id": "exitAtEnd",
      "label": "Glitch out at the end",
      "type": "checkbox",
      "value": true
    },
    {
      "id": "hideOriginals",
      "label": "Hide original layers",
      "type": "checkbox",
      "value": true
    },
    {
      "id": "reverseOrder",
      "label": "Reverse order",
      "type": "checkbox",
      "value": false
    }
  ],
  "requires": "2.0"
}