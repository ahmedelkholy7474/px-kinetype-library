{
  "id": "proximity",
  "name": "Squeezy Proximity",
  "version": 4,
  "order": 5,
  "status": "ready",
  "requires": "3.0",
  "description": "Pick one or more looks, press Go, then move the effector: the layers near it react. The preview shows what your looks do.",
  "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><circle cx=\"12\" cy=\"12\" r=\"2.5\" fill=\"currentColor\"/><circle cx=\"12\" cy=\"12\" r=\"6\" opacity=\".6\"/><circle cx=\"12\" cy=\"12\" r=\"9.5\" opacity=\".3\"/></svg>",
  "colors": [
    "#7B5CFF",
    "#2FF3FF"
  ],
  "include": [
    "_common.jsx"
  ],
  "scriptFile": "proximity.jsx",
  "runLabel": "Go",
  "params": [
    {
      "id": "action",
      "label": "Do",
      "type": "select",
      "options": [
        "Apply",
        "Add effector",
        "Follow selected layer",
        "Remove"
      ],
      "value": "Apply"
    },
    {
      "id": "looks",
      "label": "Looks (pick one or more)",
      "type": "multi",
      "options": [
        "Magnify",
        "Shrink",
        "Reveal",
        "Fade out",
        "Push away",
        "Pull in",
        "Spin",
        "Focus",
        "Color",
        "Pop"
      ],
      "value": [
        "Magnify"
      ]
    },
    {
      "id": "radius",
      "label": "Radius",
      "type": "slider",
      "min": 20,
      "max": 2000,
      "value": 300,
      "unit": "px"
    },
    {
      "id": "amount",
      "label": "Amount",
      "type": "slider",
      "min": 0,
      "max": 200,
      "value": 100,
      "unit": "%"
    },
    {
      "id": "softness",
      "label": "Softness",
      "type": "slider",
      "min": 0,
      "max": 100,
      "value": 70,
      "unit": "%",
      "advanced": true
    },
    {
      "id": "color",
      "label": "Color (hex)",
      "type": "text",
      "value": "#2FF3FF",
      "advanced": true
    },
    {
      "id": "invert",
      "label": "Invert (far layers react)",
      "type": "checkbox",
      "value": false,
      "advanced": true
    }
  ],
  "previewFile": "proximity.preview.js"
}