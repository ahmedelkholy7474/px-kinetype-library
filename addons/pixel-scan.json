{
  "id": "pixel-scan",
  "name": "Pixel Scan Reveal",
  "version": 2,
  "order": 4,
  "status": "ready",
  "description": "Glowing pixel squares scan across and reveal the selected layer (any layer: comp, shape, text, image).",
  "icon": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><rect x=\"3\" y=\"3\" width=\"5\" height=\"5\" rx=\"1\"/><rect x=\"10\" y=\"3\" width=\"5\" height=\"5\" rx=\"1\" opacity=\".6\"/><rect x=\"3\" y=\"10\" width=\"5\" height=\"5\" rx=\"1\" opacity=\".6\"/><rect x=\"10\" y=\"10\" width=\"5\" height=\"5\" rx=\"1\" opacity=\".3\"/><rect x=\"17\" y=\"17\" width=\"4\" height=\"4\" rx=\"1\" opacity=\".3\"/></svg>",
  "colors": [
    "#4BFF8A",
    "#1AE0A0"
  ],
  "include": [
    "_common.jsx"
  ],
  "scriptFile": "pixel-scan.jsx",
  "runLabel": "Reveal",
  "params": [
    {
      "id": "direction",
      "label": "Direction",
      "type": "select",
      "options": [
        "Left → Right",
        "Right → Left",
        "Top → Bottom",
        "Bottom → Top",
        "Center out",
        "Random"
      ],
      "value": "Left → Right"
    },
    {
      "id": "size",
      "label": "Block size",
      "type": "slider",
      "min": 6,
      "max": 120,
      "value": 24,
      "unit": "px"
    },
    {
      "id": "duration",
      "label": "Duration",
      "type": "slider",
      "min": 0.2,
      "max": 5,
      "step": 0.1,
      "value": 1.2,
      "unit": "s"
    },
    {
      "id": "random",
      "label": "Randomness",
      "type": "slider",
      "min": 0,
      "max": 100,
      "value": 45,
      "unit": "%"
    },
    {
      "id": "band",
      "label": "Glow band",
      "type": "slider",
      "min": 2,
      "max": 60,
      "value": 18,
      "unit": "%"
    },
    {
      "id": "color",
      "label": "Glow colour",
      "type": "select",
      "options": [
        "Cyan",
        "White",
        "Purple",
        "Pink",
        "Orange",
        "Green"
      ],
      "value": "Cyan"
    },
    {
      "id": "glow",
      "label": "Glowing squares",
      "type": "checkbox",
      "value": true
    }
  ],
  "requires": "2.0"
}