{
  "id": "pixel-scan",
  "name": "Pixel Scan Reveal",
  "version": 3,
  "order": 4,
  "status": "ready",
  "description": "Pixel-block wipe reveal with a glowing glass scan strip on the edge: turbulence, mosaic, smear, rainbow and glow. Everything stays editable on a control null.",
  "icon": "<svg viewBox=\"0 0 24 24\" fill=\"currentColor\"><rect x=\"3\" y=\"3\" width=\"5\" height=\"5\" rx=\"1\"/><rect x=\"10\" y=\"3\" width=\"5\" height=\"5\" rx=\"1\" opacity=\".6\"/><rect x=\"3\" y=\"10\" width=\"5\" height=\"5\" rx=\"1\" opacity=\".6\"/><rect x=\"10\" y=\"10\" width=\"5\" height=\"5\" rx=\"1\" opacity=\".3\"/><rect x=\"17\" y=\"17\" width=\"4\" height=\"4\" rx=\"1\" opacity=\".3\"/></svg>",
  "colors": [
    "#4BFF8A",
    "#1AE0A0"
  ],
  "include": [],
  "scriptFile": "pixel-scan.jsx",
  "runLabel": "Apply",
  "params": [
    {
      "id": "action",
      "label": "Action",
      "type": "select",
      "options": [
        "Apply",
        "Remove rig"
      ],
      "value": "Apply"
    },
    {
      "id": "direction",
      "label": "Direction",
      "type": "select",
      "options": [
        "Left → Right",
        "Right → Left",
        "Top → Bottom",
        "Bottom → Top"
      ],
      "value": "Left → Right"
    },
    {
      "id": "mode",
      "label": "Mode",
      "type": "select",
      "options": [
        "Reveal In",
        "Reveal Out"
      ],
      "value": "Reveal In"
    },
    {
      "id": "duration",
      "label": "Duration",
      "type": "slider",
      "min": 0.1,
      "max": 6,
      "step": 0.1,
      "value": 1.5,
      "unit": "s"
    },
    {
      "id": "blockSize",
      "label": "Block size",
      "type": "slider",
      "min": 2,
      "max": 200,
      "value": 40,
      "unit": "px"
    },
    {
      "id": "scanWidth",
      "label": "Scan width",
      "type": "slider",
      "min": 10,
      "max": 800,
      "value": 180,
      "unit": "px"
    },
    {
      "id": "rainbow",
      "label": "Rainbow",
      "type": "slider",
      "min": 0,
      "max": 100,
      "value": 35,
      "unit": "%"
    },
    {
      "id": "color",
      "label": "Scan colour (hex)",
      "type": "text",
      "value": "#2FF3FF"
    },
    {
      "id": "ease",
      "label": "Smooth in/out",
      "type": "checkbox",
      "value": true
    }
  ],
  "requires": "2.0"
}