{
  "id": "cursor-typewriter",
  "name": "Cursor Typewriter",
  "category": "typewriter",
  "version": 2,
  "order": 11,
  "added": "2026-10-30",
  "source": "Comp_1.mp4",
  "requires": "3.3",
  "seed": 109,
  "notes": "Real typing (Source Text expression): letters arrive one by one and join naturally in Arabic. A | cursor stays at the end, solid while typing, blinking while idle (SQ Text Cursor Blink off = hide it after typing). Out deletes back to front.",
  "typewriter": {
    "unit": "chars",
    "lead": 0.5,
    "charTime": 0.075,
    "jitter": 0.4,
    "pause": 2.4,
    "outCharTime": 0.03,
    "cursorColor": "#3CC8F0",
    "blink": 1.1
  },
  "in": {
    "animators": [
      {
        "name": "Cursor Wake",
        "basedOn": "chars",
        "start": 0,
        "stagger": 0,
        "dur": 0.45,
        "ease": "linear",
        "envelope": "gate",
        "mod": {
          "type": "expr",
          "code": "return __i == 0 ? 1 : 0;"
        },
        "props": {
          "charValue": 124,
          "fillColor": "#3CC8F0"
        }
      },
      {
        "name": "Cursor Focus",
        "basedOn": "chars",
        "start": 0,
        "stagger": 0,
        "dur": 0.35,
        "ease": "outCubic",
        "envelope": "from",
        "mod": {
          "type": "expr",
          "code": "return __i == 0 ? 1 : 0;"
        },
        "props": {
          "blur": [
            16,
            16
          ],
          "scale": [
            220,
            130
          ],
          "opacity": 20
        }
      },
      {
        "name": "Type",
        "basedOn": "chars",
        "start": 0.45,
        "stagger": 0.065,
        "dur": 0.01,
        "ease": "step",
        "envelope": "from",
        "mod": {
          "type": "expr",
          "code": "return __i == 0 ? 0 : 1;"
        },
        "props": {
          "opacity": 0
        }
      },
      {
        "name": "Cursor",
        "basedOn": "chars",
        "start": 0.45,
        "stagger": 0.065,
        "dur": 0.065,
        "ease": "linear",
        "envelope": "gate",
        "props": {
          "charValue": 124,
          "fillColor": "#3CC8F0"
        }
      }
    ]
  },
  "out": {
    "animators": [
      {
        "name": "Erase",
        "basedOn": "chars",
        "order": "forward",
        "stagger": 0.025,
        "dur": 0.3,
        "ease": "outCubic",
        "envelope": "from",
        "props": {
          "opacity": 0,
          "blur": [
            18,
            8
          ]
        }
      },
      {
        "name": "Drift",
        "basedOn": "lines",
        "dur": 0.6,
        "ease": "inOutSine",
        "envelope": "from",
        "props": {
          "position": [
            -30,
            0
          ],
          "opacity": 55
        }
      }
    ]
  }
